# Базовый URL сайта (metadataBase, sitemap, robots, canonical). Обязателен в проде
NEXT_PUBLIC_SITE_URL=

# Верификация вебмастеров (опционально)
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=

# Яндекс.Метрика (опционально)
NEXT_PUBLIC_YM_ID=

# Яндекс.РСЯ — id площадки из блоков R-A-<id>-N (опционально, без него баннер не рендерится)
NEXT_PUBLIC_RSY_ID=

# T-Bank (Тинькофф) — платёжный терминал
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# MySQL — платежи и метрики (без этих переменных платежи/метрики отключены)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Префикс таблиц в общей базе (WordPress-префикс, по умолчанию wp_)
MYSQL_TABLE_PREFIX=wp_

# ЮKassa — рекуррентные платежи (провайдер переключается в /admin: tbank | yookassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Тестовый магазин ЮKassa: используется автоматически на dev и на Vercel (VERCEL=1)
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=

# Секрет для /api/cron/billing (автопродления ЮKassa). Сгенерировать: openssl rand -hex 32
CRON_SECRET=

# Секрет для подписи токенов прокси-роута (HMAC). Сгенерировать: openssl rand -hex 32
# Обязателен в проде — без него прокси отдаёт 500
PROXY_TOKEN_SECRET=

# Внешние прокси-ноды для скачивания (масштабирование по полосе): базовые URL через запятую,
# например https://proxy1.save-tube.ru,https://proxy2.save-tube.ru
# Пусто — сегменты качаются через встроенный /api/proxy основного сервера
NEXT_PUBLIC_PROXY_URLS=

# Прокси ТОЛЬКО для API rutube.ru (нужен на serverless: API банит дата-центровые IP).
# Формат: http://user:pass@host:port, можно НЕСКОЛЬКО через запятую (ротация + ретрай).
# Трафик мизерный — 2 текстовых запроса на видео, плейлисты и сегменты идут напрямую.
# Пусто — прямое соединение (для VPS с чистым IP)
RUTUBE_API_PROXY=

# Админка /admin (метрики): email'ы с доступом (через запятую) + ключ входа (openssl rand -hex 32)
# Без ADMIN_KEY админка полностью закрыта
ADMIN_EMAILS=
ADMIN_KEY=

# Сессия ЛК (iron-session, cookie savetube_session). Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Redis — одноразовые коды входа в ЛК (OTP). Формат: redis://[:password@]host:port
# Без этой переменной вход по коду отключён (auth-роуты отвечают 503), оплата не ломается
REDIS_URL=

# SMTP — письма ЛК (welcome при авто-регистрации, одноразовый код для входа, оплата подписки)
# Без этих переменных письма тихо пропускаются (оплата/вход от почты не зависят)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# true — отключить проверку TLS-сертификата SMTP. Нужно на проде: mail.save-tube.ru —
# локальный Exim с self-signed сертификатом, иначе письма падают молча (self-signed certificate)
SMTP_INSECURE_TLS=

# Отправитель писем (в коде пока не используется — на будущее, письма после оплаты)
EMAIL_SENDER=
EMAIL_SENDER_NAME=
VIDEO_INFO_CONCURRENCY=
VIDEO_INFO_MAX_QUEUE=
